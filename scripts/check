#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

cd "$repository_root"

# A default check must never gain live-provider behavior merely because the developer has
# credentials or TLS key logging enabled in their shell. Static policy tests below provide a
# second, source-level guard.
unset OPENAI_API_KEY OPENAI_ADMIN_KEY OPENAI_WEBHOOK_SECRET
unset OPENAI_BASE_URL OPENAI_ORGANIZATION OPENAI_ORG_ID OPENAI_PROJECT_ID
unset OPENAI_CUSTOM_HEADERS OPENAI_LOG OPENAI_API_TYPE OPENAI_API_VERSION
unset OPENAI_AD_TOKEN OPENAI_ENDPOINT
unset AZURE_OPENAI_API_KEY AZURE_OPENAI_AD_TOKEN AZURE_OPENAI_ENDPOINT
unset ANTHROPIC_API_KEY GOOGLE_API_KEY GEMINI_API_KEY
unset SSLKEYLOGFILE

# Ambient uv selectors can redirect project discovery, the target environment, or the interpreter.
# Clear only selector settings; the gate supplies its own offline and cache configuration below.
unset UV_PROJECT UV_PROJECT_ENVIRONMENT UV_PYTHON UV_WORKING_DIR UV_NO_PROJECT UV_ISOLATED

# Keep dependency resolution offline. Setup is a separate, lockfile-driven step (`uv sync --dev`
# and `npm --prefix tui ci`); the first stage verifies that prepared Python environment without
# changing it, and every later Python tool invocation explicitly disables synchronization.
export UV_OFFLINE=1
export NPM_CONFIG_OFFLINE=true
export TMPDIR=/tmp
export UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/code-assist-harness-uv-cache}
export PYTHONDONTWRITEBYTECODE=1

# Preload process-level network guards into the top-level Python and Node checks. The runtime
# supervisor intentionally strips PYTHONPATH from its real Python child, preserving the prepared-
# interpreter invariant; current child code remains covered by the static source policy below. None
# of these controls claims to sandbox separately launched native executables.
export PYTHONPATH=$repository_root/tests/network_guard
node_network_guard=$repository_root/scripts/deny-network.mjs
export NODE_OPTIONS="--import=\"$node_network_guard\""

run_check() {
    label=$1
    shift

    printf '\n==> %s\n' "$label"
    "$@"
}

run_check 'Python lockfile and environment' uv sync --check --locked --offline
run_check 'Python lint and docstrings' uv run --offline --frozen --no-sync ruff check .
run_check 'Python format' uv run --offline --frozen --no-sync ruff format --check .
run_check \
    'Python tests' \
    uv run --offline --frozen --no-sync pytest \
    -m 'not live_provider' \
    --ignore=tests/protocol/test_fixtures.py \
    --ignore=tests/test_check_script.py \
    --ignore=tests/test_repository_policy.py
run_check \
    'Protocol fixtures: Python' \
    uv run --offline --frozen --no-sync pytest tests/protocol/test_fixtures.py
run_check \
    'Node runtime compatibility' \
    sh -c 'cd "$1" && exec node --import=tsx src/check-node-version.ts' \
    sh "$repository_root/tui"
run_check \
    'Repository policy: check script, documentation links, locks, and network' \
    uv run --offline --frozen --no-sync pytest \
    tests/test_check_script.py tests/test_repository_policy.py
run_check 'TUI typecheck' npm --offline --prefix tui run typecheck
run_check 'TUI lint' npm --offline --prefix tui run lint
run_check \
    'TUI tests' \
    npm --offline --prefix tui test -- \
    --exclude test/protocol-fixtures.test.ts \
    --exclude test/runtime-boundary.test.ts
run_check \
    'Protocol fixtures: TypeScript' \
    npm --offline --prefix tui test -- test/protocol-fixtures.test.ts
run_check \
    'Node-Python integration' \
    npm --offline --prefix tui test -- test/runtime-boundary.test.ts

printf '\nAll repository checks passed.\n'
